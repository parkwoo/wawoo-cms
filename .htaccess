RewriteEngine On

# Sensitive paths and extensions are hard-denied BEFORE the pretty-URL
# rewrites: cache/includes/plugins data, raw markdown (incl. drafts), JSON
# caches/inboxes, config secrets and dotfiles. RewriteRules run even for
# real files, so this also covers Apache setups that serve existing files
# without invoking router.php.
<IfModule mod_rewrite.c>
    RewriteRule ^(cache|includes|plugins)/ - [F,L]
    RewriteRule ^themes/.*\.php$ - [F,L]
    RewriteRule ^\.git(/|$) - [F,L]
    RewriteRule ^(config\.local\.php|\.env|composer\.(json|lock)|README\.md|CHANGELOG\.md|VERSION)$ - [F,L]
    RewriteRule \.(md|markdown|json|phtml|log|lock|sql|sh)$ - [F,L]
</IfModule>

# Block direct access to sensitive files. NOTE: front controllers
# (index/post/page/dispatch/router.php) must stay executable, so only
# non-entry PHP (core internals, plugin src, config) is denied here.
<IfModule mod_authz_core.c>
    <FilesMatch "\.(md|markdown|json|phtml|log|lock|sql|sh|env)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "^(\.env|config\.local\.php|composer\.(json|lock)|README\.md|CHANGELOG\.md|VERSION)$">
        Require all denied
    </FilesMatch>

    # Block direct access to internals that must only be reached via require:
    # includes/core/*, includes/Parsedown.php, and plugin/theme src files.
    <FilesMatch "(^|/)(includes|plugins|themes)/.*\.php$">
        Require all denied
    </FilesMatch>
    <FilesMatch "(core|src)\.php$">
        Require all denied
    </FilesMatch>
</IfModule>

# Pretty URLs — everything goes through the router; the router serves
# static files, core routes (/post /cat /tag), and delegates plugin pages
# (rss, search, admin, sitemap, ...) to dispatch.php.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^post/([a-zA-Z0-9_-]+)/?$ post.php?slug=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^cat/([^/]+)/?$     index.php?cat=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^tag/([^/]+)/?$     index.php?tag=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$              router.php [L,QSA]

# Cache static assets aggressively.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png  "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/css   "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# Compression.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json
</IfModule>

# Security headers.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
