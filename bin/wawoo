#!/usr/bin/env php
<?php
/**
 * wawoo-cms command-line interface.
 *
 * Designed to be friendly for AI agents: every command prints machine
 * parsable one-line summaries and never prompts.
 *
 * Usage:
 *   php bin/wawoo list                    list published posts (slug | date | title)
 *   php bin/wawoo list --all              include drafts
 *   php bin/wawoo post:new <slug> [--title "T"] [--category C] [--tags a,b]
 *   php bin/wawoo page:new <slug> [--title "T"]
 *   php bin/wawoo make:plugin <name>      scaffold a plugin directory
 *   php bin/wawoo make:theme <name>       scaffold a theme directory
 *   php bin/wawoo cache:clear             flush the file cache
 *   php bin/wawoo doctor                  environment & config self-check
 */

declare(strict_types=1);

error_reporting(E_ALL);
ini_set('display_errors', '1');

$root = dirname(__DIR__);

require $root . '/includes/core/Bootstrap.php';
\Wawoo\Core\Bootstrap::init($root);

use Wawoo\Core\Cache;
use Wawoo\Core\Pages;
use Wawoo\Core\Posts;
use Wawoo\Core\PluginManager;

$args = array_slice($argv, 1);
$cmd  = $args[0] ?? 'help';

function usage(): void
{
    echo "wawoo-cms CLI\n\n"
        . "  list [--all]                       list posts (slug | date | title)\n"
        . "  pages                              list fixed pages\n"
        . "  post:new <slug> [opts]             create a post bundle\n"
        . "  page:new <slug> [opts]             create a fixed page\n"
        . "  status <slug> <state> [--at TIME]  set draft|published|scheduled\n"
        . "  publish:due                        promote scheduled posts that are due\n"
        . "  make:plugin <name>                 scaffold a plugin\n"
        . "  make:theme <name>                  scaffold a theme\n"
        . "  cache:clear                        flush file cache\n"
        . "  plugin:link <path> [--copy]         link an optional plugin repo into plugins/\n"
        . "  theme:link <path> [--copy]          link an optional theme repo into themes/\n"
        . "  plugin:search <query> [--index F]   search the marketplace index\n"
        . "  plugin:install <name> [--enable] [--index F] [--dest D]  install a plugin from the marketplace\n"
        . "  bundle:install <name> [--enable] [--index F] [--dest D]  install a bundle from the marketplace\n"
        . "  plugins                            list plugins (name | version | enabled|disabled)\n"
        . "  themes                             list themes (name | version | active)\n"
        . "  enable <name>                      enable a plugin\n"
        . "  disable <name>                     disable a plugin\n"
        . "  theme:use <name>                   activate a theme\n"
        . "  settings <plugin>                  print a plugin's runtime settings (JSON)\n"
        . "  settings:set <plugin> <key> <value>  set a plugin runtime setting\n"
        . "  doctor                             environment self-check\n";
}

function option(array $args, string $long): string
{
    foreach ($args as $i => $a) {
        if ($a === $long && isset($args[$i + 1])) {
            return $args[$i + 1];
        }
        if (strpos($a, $long . '=') === 0) {
            return substr($a, strlen($long) + 1);
        }
    }
    return '';
}

function flag(array $args, string $long): bool
{
    return in_array($long, $args, true);
}

function slug(string $s): string
{
    $s = preg_replace('/[^a-zA-Z0-9_-]/', '-', trim($s));
    $s = trim((string)$s, '-');
    return strtolower($s);
}

function copyDirRec(string $src, string $dst): void
{
    if (!is_dir($dst)) {
        mkdir($dst, 0755, true);
    }
    foreach (scandir($src) as $e) {
        if ($e === '.' || $e === '..') {
            continue;
        }
        $s = $src . '/' . $e;
        $d = $dst . '/' . $e;
        if (is_dir($s) && !is_link($s)) {
            copyDirRec($s, $d);
        } else {
            copy($s, $d);
        }
    }
}

function writeBundle(string $dir, string $slug, string $frontmatter, string $body): void
{
    if (!is_dir($dir)) {
        mkdir($dir, 0755, true);
    }
    $file = $dir . '/index.md';
    if (file_exists($file)) {
        fwrite(STDERR, "error: {$file} already exists\n");
        exit(1);
    }
    file_put_contents($file, "---\n" . $frontmatter . "---\n\n" . $body);
    echo "created {$file}\n";
}

function readIndexFile(string $file): ?array
{
    if (!is_file($file)) {
        return null;
    }
    $raw = json_decode((string)file_get_contents($file), true);
    return (is_array($raw) && isset($raw['items']) && is_array($raw['items'])) ? $raw : null;
}

function marketIndexPath(array $args, string $root): ?string
{
    $explicit = option($args, '--index');
    if ($explicit !== '') {
        return $explicit;
    }
    $guess = dirname($root) . '/wawoo-cms-marketplace/index.json';
    return is_file($guess) ? $guess : null;
}

function copyTree(string $src, string $dst): bool
{
    if (!is_dir($src)) {
        return false;
    }
    if (!is_dir($dst) && !@mkdir($dst, 0755, true) && !is_dir($dst)) {
        return false;
    }
    $it = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($src, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::SELF_FIRST
    );
    foreach ($it as $item) {
        $target = $dst . DIRECTORY_SEPARATOR . $it->getSubPathName();
        if ($item->isDir()) {
            @mkdir($target, 0755, true);
        } else {
            @copy($item->getPathname(), $target);
        }
    }
    return true;
}

function findIndexItem(array $index, string $name): ?array
{
    foreach ($index['items'] as $item) {
        if (($item['name'] ?? null) === $name) {
            return $item;
        }
    }
    return null;
}

function installFromIndex(array $index, string $indexFile, string $name, string $destRoot, bool $enable): string
{
    $name = preg_replace('/[^A-Za-z0-9_-]/', '', $name);
    $item = findIndexItem($index, $name);
    if ($item === null) {
        return 'error: ' . $name . ' not found in index';
    }
    $dest = rtrim($destRoot, '/') . '/' . $name;
    if (is_dir($dest)) {
        return 'skip (already installed): ' . $name;
    }
    $source = is_array($item['source'] ?? null) ? $item['source'] : [];
    $kind = (string)($source['kind'] ?? '');
    if ($kind === 'hosted') {
        $from = dirname($indexFile) . '/' . ltrim((string)($source['path'] ?? ''), '/');
        if (!copyTree($from, $dest)) {
            return 'error: cannot copy hosted item ' . $name . ' from ' . $from;
        }
    } elseif ($kind === 'git') {
        $url = (string)($source['url'] ?? '');
        if ($url === '') {
            return 'error: missing git url for ' . $name;
        }
        $ref = (string)($source['ref'] ?? '');
        $cmd = 'git clone --depth 1' . ($ref !== '' ? ' --branch ' . escapeshellarg($ref) : '')
            . ' ' . escapeshellarg($url) . ' ' . escapeshellarg($dest) . ' 2>&1';
        $out = [];
        $code = 0;
        exec($cmd, $out, $code);
        if ($code !== 0) {
            return 'error: git clone failed for ' . $name . ': ' . implode(' ', $out);
        }
    } else {
        return 'error: unknown source kind for ' . $name;
    }
    if ($enable) {
        $enabled = PluginManager::enabledPlugins();
        if (!in_array($name, $enabled, true)) {
            $enabled[] = $name;
            PluginManager::setEnabledPlugins($enabled);
        }
    }
    return 'installed: ' . $name;
}

switch ($cmd) {
    case 'list':
        $all  = flag($args, '--all');
        $posts = Posts::all($all);
        if ($posts === []) {
            echo "(no posts)\n";
            break;
        }
        foreach ($posts as $p) {
            echo $p['slug'] . ' | ' . $p['date'] . ' | ' . $p['title'] . "\n";
        }
        break;

    case 'pages':
        $pages = Pages::all();
        if ($pages === []) {
            echo "(no pages)\n";
            break;
        }
        foreach ($pages as $p) {
            echo $p['slug'] . ' | ' . $p['title'] . "\n";
        }
        break;

    case 'status':
        $slug = slug($args[1] ?? '');
        $state = strtolower($args[2] ?? '');
        if ($slug === '' || !in_array($state, ['draft', 'published', 'scheduled'], true)) {
            fwrite(STDERR, "usage: status <slug> <draft|published|scheduled> [--at \"2026-09-10 09:00\"]\n");
            exit(1);
        }
        $at = $state === 'scheduled' ? option($args, '--at') : '';
        $res = Posts::setStatus($slug, $state, $at);
        if ($res === null) {
            fwrite(STDERR, "error: could not set status on '$slug'\n");
            exit(1);
        }
        echo "$slug -> $res\n";
        break;

    case 'publish:due':
        $due = Posts::due();
        echo $due === [] ? "(nothing due)\n" : "published: " . implode(', ', $due) . "\n";
        break;

    case 'post:new':
    case 'page:new':
        $slug = slug($args[1] ?? '');
        if ($slug === '') {
            fwrite(STDERR, "usage: $cmd <slug> [--title \"T\"]\n");
            exit(1);
        }        $title    = option($args, '--title') ?: ucfirst(str_replace('-', ' ', $slug));
        $isPost   = $cmd === 'post:new';
        $category = option($args, '--category') ?: 'General';
        $tags     = array_filter(array_map('trim', explode(',', option($args, '--tags'))));
        $fm       = "title: {$title}\ndate: " . date('Y-m-d')
            . ($isPost ? "\ncategory: {$category}" : '')
            . ($tags !== [] ? "\ntags: [" . implode(', ', $tags) . ']' : '')
            . "\nstatus: published\n";
        $base = $isPost ? POSTS_DIR : PAGES_DIR;
        writeBundle($base . $slug, $slug, $fm, "Write your content here.\n");
        if ($isPost) {
            Cache::flush();
        }
        break;

    case 'make:plugin':
        $name = slug($args[1] ?? '');
        if ($name === '') {
            fwrite(STDERR, "usage: make:plugin <name>\n");
            exit(1);
        }
        $ns = 'Wawoo\\Plugin\\' . implode('', array_map('ucfirst', explode('-', $name)));
        $dir = PLUGINS_DIR . $name;
        if (is_dir($dir)) {
            fwrite(STDERR, "error: {$dir} already exists\n");
            exit(1);
        }
        mkdir($dir . '/src', 0755, true);
        file_put_contents($dir . '/plugin.json', json_encode([
            'name'      => $name,
            'type'      => 'plugin',
            'version'   => '1.0.0',
            'namespace' => $ns,
            'entry'     => 'Plugin',
            'requires'  => ['core' => '>=1.0.0'],
            'hooks'     => new stdClass(),
            'config'    => new stdClass(),
        ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");
        file_put_contents($dir . '/src/Plugin.php', "<?php\nnamespace {$ns};\n\nfinal class Plugin\n{\n    public function boot(): void\n    {\n    }\n}\n");
        echo "created {$dir}/plugin.json\ncreated {$dir}/src/Plugin.php\n";
        break;

    case 'make:theme':
        $name = slug($args[1] ?? '');
        if ($name === '') {
            fwrite(STDERR, "usage: make:theme <name>\n");
            exit(1);
        }
        $ns = 'Wawoo\\Theme\\' . implode('', array_map('ucfirst', explode('-', $name)));
        $dir = THEMES_DIR . $name;
        if (is_dir($dir)) {
            fwrite(STDERR, "error: {$dir} already exists\n");
            exit(1);
        }
        mkdir($dir . '/templates', 0755, true);
        mkdir($dir . '/assets/css', 0755, true);
        file_put_contents($dir . '/theme.json', json_encode([
            'name'      => $name,
            'type'      => 'theme',
            'version'   => '1.0.0',
            'namespace' => $ns,
            'entry'     => 'Plugin',
            'requires'  => ['core' => '>=1.0.0'],
            'hooks'     => new stdClass(),
            'config'    => new stdClass(),
        ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");
        file_put_contents($dir . '/templates/index.php', "<h1>New theme: {$name}</h1>\n");
        file_put_contents($dir . '/assets/css/style.css', "/* {$name} */\n");
        echo "created {$dir}/theme.json\n";
        break;

    case 'cache:clear':
        Cache::flush();
        echo "cache cleared\n";
        break;

    case 'plugin:link':
    case 'theme:link':
        $src = trim((string)($args[1] ?? ''));
        if ($src === '' || !is_dir($src)) {
            fwrite(STDERR, "usage: $cmd <repo-path> [--copy]\n");
            exit(1);
        }
        $isPlugin = $cmd === 'plugin:link';
        $kind     = $isPlugin ? 'plugin' : 'theme';
        $relDir   = $isPlugin ? 'plugins' : 'themes';
        // Locate the payload dir: repo root may BE plugins/<name> or contain
        // plugins/<name> (standalone repo layout) or contain <name>.
        $candidates = [
            $src,
            $src . '/' . $relDir,
        ];
        $manifestName = $isPlugin ? 'plugin.json' : 'theme.json';
        $found = null;
        foreach ($candidates as $c) {
            if (!is_dir($c)) {
                continue;
            }
            foreach (glob(rtrim($c, '/') . '/*/' . $manifestName) as $mf) {
                $dir = dirname($mf);
                $name = basename($dir);
                // Skip anything already linked into this repo.
                if (str_starts_with(realpath($dir), realpath($root . '/' . $relDir))) {
                    continue;
                }
                $found = [$name, $dir];
                break 2;
            }
        }
        if ($found === null) {
            fwrite(STDERR, "error: no $kind manifest found under $src\n");
            exit(1);
        }
        [$name, $payloadDir] = $found;
        $target = $root . '/' . $relDir . '/' . $name;
        if (file_exists($target)) {
            fwrite(STDERR, "error: $relDir/$name already exists; remove it first\n");
            exit(1);
        }
        if (flag($args, '--copy')) {
            if (!is_dir($root . '/' . $relDir)) {
                mkdir($root . '/' . $relDir, 0755, true);
            }
            copyDirRec($payloadDir, $target);
            echo "copied $payloadDir -> $target\n";
        } else {
            if (!is_dir($root . '/' . $relDir)) {
                mkdir($root . '/' . $relDir, 0755, true);
            }
            if (!symlink($payloadDir, $target)) {
                fwrite(STDERR, "error: could not symlink $payloadDir\n");
                exit(1);
            }
            echo "linked $payloadDir -> $target\n";
        }
        // Also link the plugin's own PHPUnit tests (tests/Plugin/*.php in the
        // standalone repo) into this checkout so the testing contract works:
        //   phpunit tests/Plugin/<Name>*Test.php
        if ($isPlugin && is_dir($src . '/tests/Plugin')) {
            $testsTarget = $root . '/tests/Plugin';
            if (!is_dir($testsTarget)) {
                mkdir($testsTarget, 0755, true);
            }
            foreach (glob($src . '/tests/Plugin/*.php') as $tf) {
                $base = basename($tf);
                $dest = $testsTarget . '/' . $base;
                if (file_exists($dest)) {
                    fwrite(STDERR, "warn: tests/Plugin/$base already exists; skipped\n");
                    continue;
                }
                if (flag($args, '--copy')) {
                    copy($tf, $dest);
                    echo "copied tests/Plugin/$base\n";
                } else {
                    symlink($tf, $dest);
                    echo "linked tests/Plugin/$base\n";
                }
            }
        }
        break;

    case 'plugin:search':
        $idxFile = marketIndexPath($args, $root);
        $index = $idxFile !== null ? readIndexFile($idxFile) : null;
        if ($index === null) {
            fwrite(STDERR, "error: marketplace index.json not found (pass --index <path>)\n");
            exit(1);
        }
        $q = strtolower(trim((string)($args[1] ?? '')));
        $rows = array_values(array_filter($index['items'], static function ($i) use ($q): bool {
            if ($q === '') {
                return true;
            }
            $hay = strtolower((string)($i['name'] ?? '') . ' ' . (string)($i['summary'] ?? ''));
            return strpos($hay, $q) !== false;
        }));
        if ($rows === []) {
            echo "(no matches)\n";
            break;
        }
        usort($rows, static fn($a, $b) => strcmp((string)$a['name'], (string)$b['name']));
        foreach ($rows as $i) {
            echo ($i['name'] ?? '?') . ' | ' . ($i['type'] ?? '') . ' | ' . ($i['version'] ?? '')
                . ' | ' . ($i['source']['kind'] ?? '') . ' | ' . ($i['summary'] ?? '') . "\n";
        }
        break;

    case 'plugin:install':
        $name = trim((string)($args[1] ?? ''));
        if ($name === '') {
            fwrite(STDERR, "usage: plugin:install <name> [--enable] [--index F] [--dest D]\n");
            exit(1);
        }
        $idxFile = marketIndexPath($args, $root);
        $index = $idxFile !== null ? readIndexFile($idxFile) : null;
        if ($index === null) {
            fwrite(STDERR, "error: marketplace index.json not found (pass --index <path>)\n");
            exit(1);
        }
        $dest = option($args, '--dest') ?: PLUGINS_DIR;
        if (str_contains($dest, '..')) {
            fwrite(STDERR, "error: --dest must not contain '..'\n");
            exit(1);
        }
        $result = installFromIndex($index, $idxFile, $name, $dest, flag($args, '--enable'));
        echo $result . "\n";
        exit(strpos($result, 'error:') === 0 ? 1 : 0);

    case 'bundle:install':
        $bname = trim((string)($args[1] ?? ''));
        $idxFile = marketIndexPath($args, $root);
        $index = $idxFile !== null ? readIndexFile($idxFile) : null;
        if ($bname === '' || $index === null) {
            fwrite(STDERR, "usage: bundle:install <name> [--enable] [--index F] [--dest D]\n");
            exit(1);
        }
        $bundleFile = dirname($idxFile) . '/bundles/' . basename($bname) . '.json';
        $bundle = is_file($bundleFile) ? json_decode((string)file_get_contents($bundleFile), true) : null;
        if (!is_array($bundle) || !is_array($bundle['plugins'] ?? null)) {
            fwrite(STDERR, "error: bundle not found: " . $bname . "\n");
            exit(1);
        }
        $dest = option($args, '--dest') ?: PLUGINS_DIR;
        if (str_contains($dest, '..')) {
            fwrite(STDERR, "error: --dest must not contain '..'\n");
            exit(1);
        }
        $fail = false;
        foreach ($bundle['plugins'] as $n) {
            $result = installFromIndex($index, $idxFile, (string)$n, $dest, flag($args, '--enable'));
            echo $result . "\n";
            $fail = $fail || strpos($result, 'error:') === 0;
        }
        exit($fail ? 1 : 0);

    case 'plugins':
        $items = PluginManager::discoverPlugins($root);
        if ($items === []) {
            echo "(no plugins)\n";
            break;
        }
        usort($items, static fn($a, $b) => strcmp((string)$a['name'], (string)$b['name']));
        $enabled = PluginManager::enabledPlugins();
        foreach ($items as $m) {
            $state = in_array($m['name'] ?? '', $enabled, true) ? 'enabled' : 'disabled';
            echo ($m['name'] ?? '?') . ' | ' . ($m['version'] ?? '?') . ' | ' . $state . ' | ' . ($m['_path'] ?? '') . "\n";
        }
        break;

    case 'themes':
        $items = PluginManager::discoverThemes($root);
        if ($items === []) {
            echo "(no themes)\n";
            break;
        }
        usort($items, static fn($a, $b) => strcmp((string)$a['name'], (string)$b['name']));
        $active = PluginManager::activeTheme();
        foreach ($items as $m) {
            $state = ($m['name'] ?? null) === $active ? 'active' : '';
            echo ($m['name'] ?? '?') . ' | ' . ($m['version'] ?? '?') . ' | ' . $state . "\n";
        }
        break;

    case 'enable':
    case 'disable':
        $name = trim((string)($args[1] ?? ''));
        $known = array_column(PluginManager::discoverPlugins($root), 'name');
        if ($name === '' || !in_array($name, $known, true)) {
            fwrite(STDERR, "usage: $cmd <plugin-name>  (known: " . implode(', ', $known) . ")\n");
            exit(1);
        }
        $enabled = PluginManager::enabledPlugins();
        if ($cmd === 'enable') {
            if (!in_array($name, $enabled, true)) {
                $enabled[] = $name;
            }
        } else {
            $enabled = array_values(array_filter($enabled, static fn($n) => $n !== $name));
        }
        PluginManager::setEnabledPlugins($enabled);
        echo ($cmd === 'enable' ? 'enabled ' : 'disabled ') . $name . "\n";
        break;

    case 'theme:use':
        $name = trim((string)($args[1] ?? ''));
        $known = array_column(PluginManager::discoverThemes($root), 'name');
        if ($name === '' || !in_array($name, $known, true)) {
            fwrite(STDERR, "usage: theme:use <theme-name>  (known: " . implode(', ', $known) . ")\n");
            exit(1);
        }
        PluginManager::setActiveTheme($name);
        echo "active theme: " . $name . "\n";
        break;

    case 'settings':
    case 'settings:set':
        $name = trim((string)($args[1] ?? ''));
        $name = preg_replace('/[^A-Za-z0-9_-]/', '', $name);
        if ($name === '') {
            fwrite(STDERR, "usage: $cmd <plugin> [<key> <value>]\n");
            exit(1);
        }
        $file = CACHE_DIR . 'settings/' . $name . '.json';
        $data = [];
        if (is_file($file)) {
            $raw = json_decode((string)file_get_contents($file), true);
            if (is_array($raw)) {
                $data = $raw;
            }
        }
        if ($cmd === 'settings') {
            echo json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n";
            break;
        }
        $key = (string)($args[2] ?? '');
        $val = (string)($args[3] ?? '');
        if ($key === '') {
            fwrite(STDERR, "usage: settings:set <plugin> <key> <value>\n");
            exit(1);
        }
        $decoded = json_decode($val, true);
        $data[$key] = json_last_error() === JSON_ERROR_NONE ? $decoded : $val;
        if (!is_dir(dirname($file))) {
            @mkdir(dirname($file), 0755, true);
        }
        file_put_contents($file, json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n");
        echo "set " . $name . "." . $key . "\n";
        break;

    case 'doctor':
        $ok = true;
        $checks = [
            'PHP >= 8.1'         => version_compare(PHP_VERSION, '8.1.0', '>='),
            'POSTS_DIR writable' => is_writable(POSTS_DIR) || is_dir(POSTS_DIR),
            'CACHE_DIR writable' => is_writable(CACHE_DIR) || is_dir(CACHE_DIR),
            'config.local.php'   => is_file($root . '/config.local.php'),
        ];
        foreach ($checks as $label => $pass) {
            echo ($pass ? 'ok   ' : 'FAIL ') . $label . "\n";
            $ok = $ok && $pass;
        }
        echo 'plugins dir: ' . PLUGINS_DIR . "\n";
        echo 'themes  dir: ' . THEMES_DIR . "\n";
        echo 'posts   dir: ' . POSTS_DIR . "\n";
        echo 'pages   dir: ' . (defined('PAGES_DIR') ? PAGES_DIR : '(n/a)') . "\n";
        exit($ok ? 0 : 1);

    default:
        usage();
        exit(0);
}
